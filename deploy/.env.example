# Скопируйте в deploy/.env на сервере и заполните. Файл .env НЕ коммитьте.
# bootstrap.sh создаёт его сам со случайными секретами; впишите только токен бота.

# Пароль базы данных (любой длинный случайный).
POSTGRES_PASSWORD=change-me

# Адрес API снаружи (нужен для регистрации вебхука бота).
PUBLIC_BASE_URL=https://api.example.com

# Ключ подписи токенов: минимум 32 случайных символа.
JWT_SECRET=change-me-to-a-long-random-string

# Бот ДЛЯ ВХОДА (не тот, что присылает APK). Токен выдаёт @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Любая случайная строка от 16 символов: Telegram будет присылать её в заголовке вебхука.
TELEGRAM_WEBHOOK_SECRET=change-me-too-random-string
